      <script>
    (function () {
        var tracks = document.querySelectorAll('.hero-marquee-scroll');
        console.log('[marquee] found', tracks.length, 'scroll track(s)');

        tracks.forEach(function (track) {
            var wrap     = track.parentElement;
            var pos      = 0;
            var half     = 0;
            var duration = parseFloat(track.dataset.duration) || 40;
            var active   = false;

            console.log('[marquee] init track:', track, 'duration:', duration);

            function getMatrixX(el) {
                var t = window.getComputedStyle(el).transform;
                console.log('[marquee] raw transform:', t);
                if (!t || t === 'none') return 0;
                var m = t.match(/matrix\(([^)]+)\)/);
                return m ? parseFloat(m[1].split(',')[4]) : 0;
            }

            wrap.addEventListener('mouseenter', function () {
                half = track.scrollWidth / 2;
                pos  = getMatrixX(track);
                active = true;
                console.log('[marquee] mouseenter — half:', half, 'pos:', pos);
                track.style.animation = 'none';
                track.style.transform = 'translateX(' + pos + 'px)';
            });

            wrap.addEventListener('wheel', function (e) {
                console.log('[marquee] wheel — active:', active, 'deltaX:', e.deltaX, 'deltaY:', e.deltaY, 'deltaMode:', e.deltaMode);
                if (!active) return;
                e.preventDefault();
                var delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
                pos -= delta;
                if (pos < -half) pos += half;
                if (pos > 0)     pos -= half;
                console.log('[marquee] new pos:', pos);
                track.style.transform = 'translateX(' + pos + 'px)';
            }, { passive: false });

            wrap.addEventListener('mouseleave', function () {
                active = false;
                if (!half) half = track.scrollWidth / 2;
                var progress = Math.abs(pos) / half;
                var delay    = -(progress * duration);
                console.log('[marquee] mouseleave — resuming at progress:', progress, 'delay:', delay);
                track.style.transform = '';
                track.style.animation = 'hero-marquee ' + duration + 's ' + delay + 's linear infinite';
            });
        });
    })();
    </script>
        <script>
    (function($){
        // Sessions / posts load-more
        $(document).on('click', '.sf-symposium-loadmore', function(){
            var $btn = $(this);
            if ($btn.prop('disabled') || $btn.hasClass('sf-pn-loading')) return;
            $btn.addClass('sf-pn-loading').text('Loading...');
            var page     = parseInt($btn.data('page'), 10) + 1;
            var category = $btn.data('category');
            var nonce    = $btn.data('nonce');
            var $grid    = $btn.closest('.sf-pn-wrap').find('.sf-pn-grid');
            $.post('https://www.spacefoundation.org/wp-json/sf/v1/symposium-posts', {
                page: page, category: category
            }, function(res){
                if (res && res.html !== undefined) {
                    $grid.append(res.html);
                    $btn.data('page', page).removeClass('sf-pn-loading');
                    if (res.has_more) { $btn.text('Load More'); }
                    else { $btn.prop('disabled', true).text('No More Posts'); }
                } else {
                    $btn.removeClass('sf-pn-loading').text('Load More');
                }
            }).fail(function(){ $btn.removeClass('sf-pn-loading').text('Load More'); });
        });

        // Videos load-more
        $(document).on('click', '.sf-symposium-video-loadmore', function(){
            var $btn = $(this);
            if ($btn.prop('disabled') || $btn.hasClass('sf-pn-loading')) return;
            $btn.addClass('sf-pn-loading').text('Loading...');
            var page  = parseInt($btn.data('page'), 10) + 1;
            var term  = $btn.data('term');
            var nonce = $btn.data('nonce');
            var $grid = $btn.closest('.sf-pn-wrap').find('.sf-pn-grid');
            $.post('https://www.spacefoundation.org/wp-json/sf/v1/symposium-videos', {
                page: page, term: term
            }, function(res){
                if (res && res.html !== undefined) {
                    $grid.append(res.html);
                    $btn.data('page', page).removeClass('sf-pn-loading');
                    if (res.has_more) { $btn.text('Load More'); }
                    else { $btn.prop('disabled', true).text('No More Videos'); }
                } else {
                    $btn.removeClass('sf-pn-loading').text('Load More');
                }
            }).fail(function(){ $btn.removeClass('sf-pn-loading').text('Load More'); });
        });
    })(jQuery);
    </script>
